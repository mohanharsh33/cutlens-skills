# cutlens-skills BYOK Configuration
# Copy this file to `.env` for local overrides. Never commit `.env` to Git.
# Core media probing, color/LUT extraction, audio telemetry, and QA run 100% offline with zero API keys.

CUTLENS_ARTIFACTS_DIR=./artifacts
CUTLENS_FFMPEG_BIN=
CUTLENS_FFPROBE_BIN=
CUTLENS_SCENE_THRESHOLD=0.30
CUTLENS_MIN_SHOT_SECONDS=0.50
CUTLENS_TARGET_LUFS=-14.0

# Optional BYOK OpenAI-compatible Vision-Language Model (used ONLY on low-confidence shots)
CUTLENS_VLM_BASE_URL=
CUTLENS_VLM_API_KEY=
CUTLENS_VLM_MODEL=
CUTLENS_VLM_TIMEOUT_SECONDS=45

CUTLENS_ENABLE_LOCAL_ASR=false
CUTLENS_ENABLE_LOCAL_OCR=false
